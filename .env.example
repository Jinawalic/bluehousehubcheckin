# Database Configuration
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000

# Admin authentication. Set both in Vercel and locally before signing in.
# The first successful login creates this administrator record with a secure password hash.
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@bluehouse.tech
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Hub Administrator
